---
// Encabezado de sección del Home con enlace "Ver todos" al hub del silo
// (enlazado interno Hub & Spoke).
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  hubHref: string;
  hubLabel: string;
}

const { id, eyebrow, title, intro, hubHref, hubLabel } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">{eyebrow}</p>
    <h2 id={id} class="mt-2 text-3xl font-semibold sm:text-4xl">{title}</h2>
    {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
  </div>
  <a href={hubHref} class="text-sm font-semibold text-accent underline-offset-4 hover:underline">
    {hubLabel} <span aria-hidden="true">→</span>
  </a>
</div>
