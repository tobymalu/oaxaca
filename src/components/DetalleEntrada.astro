---
// Plantilla de la página individual de cualquier silo. El cuerpo MDX llega
// por el slot por defecto; el slot "sidebar" es opcional (precios) y el
// slot "relacionados" va debajo del artículo a todo lo ancho.
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  silo: { label: string; path: string };
  eyebrow: string;
  titulo: string;
  nombreCorto: string;
  descripcion: string;
  path: string;
  imagen?: { src: ImageMetadata; alt: string };
  /** Si el .mdx no tiene cuerpo todavía se muestra el aviso [DATO FALTANTE]. */
  conContenido: boolean;
}

const { silo, eyebrow, titulo, nombreCorto, descripcion, path, imagen, conContenido } = Astro.props;
const conSidebar = Astro.slots.has('sidebar');
---

<header class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8">
  <Breadcrumbs items={[{ label: silo.label, href: silo.path }, { label: nombreCorto, href: path }]} />
  <p class="mt-8 text-sm font-semibold uppercase tracking-widest text-accent">{eyebrow}</p>
  <h1 class="mt-2 max-w-4xl text-4xl font-semibold leading-tight sm:text-5xl">{titulo}</h1>
  <p class="mt-5 max-w-3xl text-lg text-muted">{descripcion}</p>
</header>

{
  imagen && (
    <div class="mx-auto mt-10 max-w-7xl px-4 sm:px-6 lg:px-8">
      <Image
        src={imagen.src}
        alt={imagen.alt}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        format="webp"
        quality={75}
        loading="eager"
        fetchpriority="high"
        class="aspect-[21/9] w-full rounded-2xl object-cover"
      />
    </div>
  )
}

<div
  class:list={[
    'mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8',
    conSidebar && 'grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start',
  ]}
>
  <article class="prose prose-oaxaca prose-lg max-w-none">
    {
      conContenido ? (
        <slot />
      ) : (
        <p class="rounded-2xl border border-dashed border-foreground/20 p-6 text-muted not-prose">
          [DATO FALTANTE]: contenido de este artículo.
        </p>
      )
    }
  </article>

  <slot name="sidebar" />
</div>

<slot name="relacionados" />
