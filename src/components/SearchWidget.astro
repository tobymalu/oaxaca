---
// Widget de búsqueda tipo OTA. Pestañas con radios nativos (cero JS):
// el valor viaja como `tipo` en el GET a la página de búsqueda del idioma.
import { PAGE_PATHS } from '../i18n/rutas';
import { getLang, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);

const TABS = (['tours', 'hospedaje', 'traslados'] as const).map((value) => ({ value, label: t.search.tabs[value] }));

const SUGERENCIAS = [
  'Oaxaca de Juárez',
  'Monte Albán',
  'Hierve el Agua',
  'Mitla',
  'Ruta del Mezcal',
  'Puerto Escondido',
  'Mazunte',
  'Huatulco',
  'Sierra Norte',
];
---

<form
  id="planear"
  action={PAGE_PATHS.buscar[lang]}
  method="get"
  class="w-full max-w-4xl rounded-2xl bg-background p-4 text-left text-foreground shadow-2xl sm:p-6"
>
  <fieldset>
    <legend class="sr-only">{t.search.legend}</legend>
    <div class="flex gap-2">
      {
        TABS.map((tab, i) => (
          <label class="cursor-pointer">
            <input type="radio" name="tipo" value={tab.value} class="peer sr-only" checked={i === 0} />
            <span class="inline-block rounded-full px-4 py-2 text-sm font-semibold text-muted transition peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:ring-2 peer-focus-visible:ring-foreground peer-focus-visible:ring-offset-2 hover:bg-surface peer-checked:hover:bg-primary">
              {tab.label}
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-4 grid gap-3 md:grid-cols-[2fr_1fr_1fr_auto] md:items-end">
    <div>
      <label for="buscar-q" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-muted">
        {t.search.query}
      </label>
      <input
        id="buscar-q"
        name="q"
        type="search"
        list="buscar-sugerencias"
        placeholder={t.search.placeholder}
        autocomplete="off"
        class="w-full rounded-lg border border-foreground/15 bg-background px-4 py-3 text-base placeholder:text-muted/70 focus:border-primary focus:ring-2 focus:ring-primary/40 focus:outline-none"
      />
      <datalist id="buscar-sugerencias">
        {SUGERENCIAS.map((s) => <option value={s} />)}
      </datalist>
    </div>

    <div>
      <label for="buscar-llegada" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-muted">
        {t.search.arrival}
      </label>
      <input
        id="buscar-llegada"
        name="llegada"
        type="date"
        class="w-full rounded-lg border border-foreground/15 bg-background px-4 py-3 text-base focus:border-primary focus:ring-2 focus:ring-primary/40 focus:outline-none"
      />
    </div>

    <div>
      <label for="buscar-salida" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-muted">
        {t.search.departure}
      </label>
      <input
        id="buscar-salida"
        name="salida"
        type="date"
        class="w-full rounded-lg border border-foreground/15 bg-background px-4 py-3 text-base focus:border-primary focus:ring-2 focus:ring-primary/40 focus:outline-none"
      />
    </div>

    <button
      type="submit"
      class="rounded-lg bg-primary px-8 py-3 text-base font-semibold text-primary-foreground shadow-sm transition hover:brightness-95 focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      {t.search.submit}
    </button>
  </div>
</form>
