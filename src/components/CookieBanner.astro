---
// Botones "Aceptar" y "Rechazar" del mismo tamaño/prominencia (GDPR).
// Ambos actualizan gtag('consent','update'), hacen dataLayer.push y
// guardan la elección bajo la misma clave que lee GoogleTagManager.astro.
import { getLang, useT } from '../i18n/ui';

const t = useT(getLang(Astro.currentLocale));
---

<div
  id="cookie-banner"
  class="fixed inset-x-4 bottom-4 z-50 hidden max-w-xl rounded-lg border border-muted/20 bg-surface p-5 shadow-lg sm:inset-x-auto sm:left-4"
  role="dialog"
  aria-live="polite"
  aria-label={t.cookies.aria}
>
  <p class="text-sm text-muted">{t.cookies.text}</p>
  <div class="mt-4 flex gap-3">
    <button
      id="cookie-accept"
      type="button"
      class="flex-1 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition hover:opacity-90"
    >
      {t.cookies.accept}
    </button>
    <button
      id="cookie-reject"
      type="button"
      class="flex-1 rounded-md border border-foreground/30 px-4 py-2 text-sm font-medium text-foreground transition hover:bg-foreground/5"
    >
      {t.cookies.reject}
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'visitaoaxaca_cookie_consent';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;

    var stored = null;
    try {
      stored = localStorage.getItem(STORAGE_KEY);
    } catch (e) {
      // sin acceso a localStorage — mostramos el banner igual, pero no persistirá.
    }

    if (!stored) {
      banner.classList.remove('hidden');
    }

    function setConsent(choice) {
      var granted = choice === 'accepted';
      window.dataLayer = window.dataLayer || [];
      if (window.gtag) {
        window.gtag('consent', 'update', {
          ad_storage: granted ? 'granted' : 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          ad_user_data: granted ? 'granted' : 'denied',
          ad_personalization: granted ? 'granted' : 'denied',
        });
      }
      window.dataLayer.push({ event: 'cookie_consent_' + choice });

      try {
        localStorage.setItem(STORAGE_KEY, choice);
      } catch (e) {
        // no-op si no hay localStorage disponible.
      }

      banner.classList.add('hidden');
    }

    var acceptBtn = document.getElementById('cookie-accept');
    var rejectBtn = document.getElementById('cookie-reject');
    if (acceptBtn) acceptBtn.addEventListener('click', function () { setConsent('accepted'); });
    if (rejectBtn) rejectBtn.addEventListener('click', function () { setConsent('rejected'); });
  })();
</script>
