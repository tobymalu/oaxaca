---
import { SITE, NAV_LINKS } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-muted/15 bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-heading text-xl font-semibold tracking-tight text-foreground">
      {SITE.name}
    </a>

    <nav aria-label="Principal">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition hover:text-primary',
                  currentPath === link.href ? 'text-primary' : 'text-foreground',
                ]}
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
