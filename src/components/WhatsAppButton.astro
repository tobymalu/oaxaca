---
import { SITE, whatsappUrl } from '../lib/site';
import { getLang, useT } from '../i18n/ui';

const t = useT(getLang(Astro.currentLocale));
---

{
  SITE.whatsapp.number && (
    <a
      href={whatsappUrl(t.whatsappMessages.default)}
      target="_blank"
      rel="noopener"
      aria-label={t.a11y.whatsapp}
      class="fixed right-4 bottom-4 z-40 flex size-14 items-center justify-center rounded-full bg-accent text-accent-foreground shadow-lg transition hover:scale-105 focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      <svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.8h-.01a9.8 9.8 0 01-5-1.37l-.36-.21-3.72.97 1-3.62-.24-.37a9.8 9.8 0 1118.15-5.23 9.8 9.8 0 01-9.82 9.83zm8.35-18.17A11.75 11.75 0 0012.04.2C5.54.2.25 5.48.25 11.98c0 2.08.54 4.1 1.58 5.89L.15 24l6.27-1.65a11.76 11.76 0 005.62 1.43h.01c6.5 0 11.79-5.29 11.79-11.79 0-3.15-1.23-6.11-3.45-8.36z" />
      </svg>
    </a>
  )
}
