---
import type { CollectionEntry } from 'astro:content';
import DestinoCard from './DestinoCard.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  destinos: CollectionEntry<'destinos'>[];
}

const { destinos } = Astro.props;
---

<section id="regiones" aria-labelledby="regiones-titulo" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <SectionHeader
    id="regiones-titulo"
    eyebrow="Destinos"
    title="Explora las Regiones de Oaxaca"
    hubHref="/destinos"
    hubLabel="Ver todos los destinos"
  />

  <ul class="mt-10 grid gap-6 md:grid-cols-3">
    {
      destinos.map((destino) => (
        <li>
          <DestinoCard destino={destino} />
        </li>
      ))
    }
  </ul>
</section>
