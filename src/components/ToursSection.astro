---
import type { CollectionEntry } from 'astro:content';
import TourCard from './TourCard.astro';
import SectionHeader from './SectionHeader.astro';
import { entradaHref } from '../lib/colecciones';
import { SILO_PATHS } from '../i18n/rutas';
import { getLang, useT } from '../i18n/ui';

interface Props {
  experiencias: CollectionEntry<'experiencias'>[];
  /** id de destino → nombre corto, para la etiqueta de región de cada tarjeta. */
  nombresDestino: Record<string, string>;
}

const { experiencias, nombresDestino } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<section id="experiencias" aria-labelledby="experiencias-titulo" class="bg-surface py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      id="experiencias-titulo"
      eyebrow={t.home.experiencias.eyebrow}
      title={t.home.experiencias.title}
      intro={t.home.experiencias.intro}
      hubHref={SILO_PATHS.experiencias[lang]}
      hubLabel={t.home.experiencias.hub}
    />
  </div>

  <!-- Carrusel con scroll-snap en móvil/tablet, grid de 4 columnas en desktop -->
  <ul
    class="mx-auto mt-10 flex max-w-7xl snap-x snap-mandatory gap-5 overflow-x-auto scroll-px-4 px-4 pb-4 sm:scroll-px-6 sm:px-6 lg:grid lg:grid-cols-4 lg:overflow-visible lg:px-8"
    tabindex="0"
    aria-label={t.home.experiencias.listLabel}
  >
    {
      experiencias.map((experiencia) => (
        <li class="w-[80%] shrink-0 snap-start sm:w-[45%] lg:w-auto">
          <TourCard
            experiencia={experiencia}
            destinoNombre={nombresDestino[experiencia.data.destino.id] ?? ''}
            href={entradaHref('experiencias', experiencia.id)}
          />
        </li>
      ))
    }
  </ul>
</section>
