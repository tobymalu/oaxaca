---
import type { CollectionEntry } from 'astro:content';
import ArticuloCard from './ArticuloCard.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  articulos: CollectionEntry<'gastronomia'>[];
}

const { articulos } = Astro.props;
---

<section id="guia" aria-labelledby="guia-titulo" class="bg-surface py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      id="guia-titulo"
      eyebrow="Gastronomía"
      title="Guía Local: Lo que debes saber"
      hubHref="/gastronomia"
      hubLabel="Ver la guía gastronómica"
    />

    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {
        articulos.map((articulo) => (
          <li>
            <ArticuloCard articulo={articulo} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
