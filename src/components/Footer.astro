---
import { SITE, NAV_LINKS, PARTNER_LINKS, hasContact, whatsappUrl } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-muted/15 bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-3 sm:px-6">
    <div>
      <p class="font-heading text-lg font-semibold">{SITE.name}</p>
      <p class="mt-2 text-sm text-muted">{SITE.tagline}</p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-muted">Explora</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="transition hover:text-secondary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-muted">Socios comerciales</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          PARTNER_LINKS.map((link) => (
            <li>
              <a href={link.href} class="transition hover:text-secondary" rel="noopener" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      {
        hasContact && (
          <ul class="mt-6 space-y-2 text-sm">
            {SITE.email && (
              <li>
                <a href={`mailto:${SITE.email}`} class="transition hover:text-secondary">
                  {SITE.email}
                </a>
              </li>
            )}
            {SITE.phone.e164 && (
              <li>
                <a href={`tel:${SITE.phone.e164}`} class="transition hover:text-secondary">
                  {SITE.phone.display}
                </a>
              </li>
            )}
            {SITE.whatsapp.number && (
              <li>
                <a href={whatsappUrl()} class="transition hover:text-secondary" rel="noopener" target="_blank">
                  WhatsApp
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>
  </div>

  <div class="border-t border-muted/15">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted sm:px-6">
      © {year} {SITE.name}. Todos los derechos reservados.
    </p>
  </div>
</footer>
