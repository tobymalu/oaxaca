---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { precioDesde, formatPrecio } from '../lib/precios';

interface Props {
  experiencia: CollectionEntry<'experiencias'>;
  /** Nombre corto del destino referenciado (resuelto por la página). */
  destinoNombre: string;
  href?: string;
  headingLevel?: 'h2' | 'h3';
}

const { experiencia, destinoNombre, href, headingLevel: Heading = 'h3' } = Astro.props;
const { nombre_corto, imagen_portada, badge, calificacion, precios } = experiencia.data;
const desde = precioDesde(precios);
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-foreground/10 bg-background shadow-sm transition hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden">
    {
      imagen_portada ? (
        <Image
          src={imagen_portada.src}
          alt={imagen_portada.alt}
          width={640}
          widths={[320, 480, 640]}
          sizes="(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 80vw"
          format="webp"
          class="absolute inset-0 h-full w-full object-cover"
        />
      ) : (
        <ImagePlaceholder label={nombre_corto} class="absolute inset-0" />
      )
    }
    {
      badge && (
        <span class="absolute top-3 left-3 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-foreground shadow">
          {badge}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-medium uppercase tracking-wide text-muted">{destinoNombre}</p>
    <Heading class="mt-1 font-heading text-lg font-semibold leading-snug">{nombre_corto}</Heading>

    {
      calificacion ? (
        <p class="mt-2 flex items-center gap-1 text-sm">
          <svg class="size-4 text-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.5 7.7l5.9-.9z" />
          </svg>
          <span class="font-semibold">{calificacion.valor.toFixed(1)}</span>
          <span class="text-muted">({calificacion.resenas} reseñas)</span>
        </p>
      ) : (
        <p class="mt-2 text-sm text-muted">Calificación: [DATO FALTANTE]</p>
      )
    }

    <div class="mt-auto flex items-end justify-between gap-3 pt-5">
      <p class="text-sm text-muted">
        Desde
        <span class="block text-lg font-semibold text-foreground">
          {desde ? formatPrecio(desde) : '[DATO FALTANTE]'}
        </span>
      </p>
      {
        href ? (
          <a
            href={href}
            class="shrink-0 rounded-full border border-foreground/20 px-4 py-2 text-sm font-medium whitespace-nowrap transition hover:border-accent hover:text-accent"
          >
            Ver detalles<span class="sr-only"> de {nombre_corto}</span>
          </a>
        ) : (
          <span class="text-sm font-medium text-muted">Próximamente</span>
        )
      }
    </div>
  </div>
</article>
