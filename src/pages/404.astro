---
// Cloudflare sirve un único 404.html para todo el sitio (es y en), por eso
// esta página es bilingüe en lugar de tener una versión por idioma.
import Layout from '../layouts/Layout.astro';
import { PAGE_PATHS } from '../i18n/rutas';
---

<Layout
  title="Página no encontrada · Page not found"
  description="La página que buscas no existe o fue movida."
  noindex
  translations={PAGE_PATHS.home}
>
  <section class="mx-auto max-w-2xl px-4 py-32 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent">Error 404</p>
    <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">Este camino no lleva a ningún lado</h1>
    <p class="mt-6 text-muted">
      La página que buscas no existe o fue movida. Regresa al inicio para seguir explorando Oaxaca.
    </p>
    <a
      href={PAGE_PATHS.home.es}
      class="mt-8 inline-block rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:brightness-95"
    >
      Volver al inicio
    </a>

    <div lang="en" class="mt-12 border-t border-foreground/10 pt-8">
      <p class="text-muted">This page doesn't exist or has moved.</p>
      <a href={PAGE_PATHS.home.en} hreflang="en" class="mt-2 inline-block text-sm font-semibold text-accent underline-offset-4 hover:underline">
        Go to the English site <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
