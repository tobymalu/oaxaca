---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DetalleEntrada from '../../components/DetalleEntrada.astro';
import TourCard from '../../components/TourCard.astro';
import { SILOS, entradaHref, getSilo, tieneContenido } from '../../lib/colecciones';
import { ogImageDe } from '../../lib/og';

export async function getStaticPaths() {
  const entradas = await getCollection('destinos');
  return entradas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'destinos'>;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const conContenido = tieneContenido(entry);
const ogImage = await ogImageDe(data.imagen_portada);

// Hub → spokes: experiencias que referencian este destino.
const experiencias = (await getSilo('experiencias')).filter((e) => e.data.destino.id === entry.id);
---

<Layout
  title={data.seo.meta_title}
  description={data.seo.meta_description}
  noindex={data.seo.noindex || !conContenido}
  ogImage={ogImage}
  ogType="article"
>
  <DetalleEntrada
    silo={SILOS.destinos}
    eyebrow="Destino"
    titulo={data.titulo}
    nombreCorto={data.nombre_corto}
    descripcion={data.descripcion}
    path={entradaHref('destinos', entry.id)}
    imagen={data.imagen_portada}
    conContenido={conContenido}
  >
    <Content />

    {
      experiencias.length > 0 && (
        <section slot="relacionados" aria-labelledby="experiencias-destino" class="bg-surface py-16">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 id="experiencias-destino" class="text-3xl font-semibold">
              Experiencias en {data.nombre_corto}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {experiencias.map((experiencia) => (
                <li>
                  <TourCard
                    experiencia={experiencia}
                    destinoNombre={data.nombre_corto}
                    href={entradaHref('experiencias', experiencia.id)}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </DetalleEntrada>
</Layout>
