---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="text-sm font-semibold uppercase tracking-widest text-secondary">Oaxaca, México</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-6xl">
        Descubre la Oaxaca que se vive, se come y se recuerda
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Cultura zapoteca y mixteca, mercados llenos de color, mezcal artesanal y playas de la costa.
        Todo lo que necesitas para planear tu viaje, en un solo lugar.
      </p>
    </div>
  </section>
</Layout>
