---
import Layout from '../../layouts/Layout.astro';
import CategoryHeader from '../../components/CategoryHeader.astro';
import ServicioCard from '../../components/ServicioCard.astro';
import EmptySilo from '../../components/EmptySilo.astro';
import { getSilo } from '../../lib/colecciones';

const servicios = await getSilo('servicios');
---

<Layout
  title="Servicios para viajeros en Oaxaca: traslados, bodas y viajes"
  description="Traslados privados aeropuerto–hotel, bodas de destino y viajes a la medida en Oaxaca. Servicios premium con expertos locales y precios claros."
>
  <CategoryHeader
    breadcrumb="Servicios"
    path="/servicios"
    eyebrow="Servicios premium"
    h1="Servicios para Viajeros en Oaxaca: Traslados, Bodas y Viajes a la Medida"
    intro="Resolvemos la logística de tu viaje para que solo te ocupes de disfrutar Oaxaca: transporte privado, planeación de bodas de destino e itinerarios diseñados para ti."
  />

  <section aria-label="Listado de servicios" class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    {
      servicios.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {servicios.map((servicio) => (
            <li>
              <ServicioCard servicio={servicio} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <EmptySilo />
      )
    }
  </section>
</Layout>
