---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import { SITE, BRAND_COLORS } from '../lib/site';
import { DEFAULT_LANG, LANGS, LOCALE_TAGS, type Alternates } from '../i18n/rutas';
import { getLang, useT } from '../i18n/ui';

interface Props {
  /** <title> y og:title — distinto del H1 editorial de la página. Default: meta.defaultTitle del idioma. */
  title?: string;
  /** Default: meta.defaultDescription del idioma. */
  description?: string;
  /** Ruta absoluta opcional para forzar el canonical (ej. contenido duplicado/paginado). */
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Header transparente sobre un hero a pantalla completa (la página no debe dejar espacio arriba). */
  transparentHeader?: boolean;
  /** Versiones de esta página por idioma → selector de idioma. Incluye la actual. */
  translations?: Alternates;
  /** Versiones indexables → hreflang. Default: `translations`. */
  hreflang?: Alternates;
}

const lang = getLang(Astro.currentLocale);
const t = useT(lang);

// Con build.format 'file' el pathname llega como /destinos.html o /index.html;
// se normaliza a la URL pública sin extensión ni barra final (/destinos, /).
const publicPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';

const {
  title = t.meta.defaultTitle,
  description = t.meta.defaultDescription,
  canonicalPath,
  noindex = false,
  // TODO: reemplazar por una imagen OG real (1200×630) cuando haya fotografía.
  ogImage = '/favicon.svg',
  ogType = 'website',
  transparentHeader = false,
  translations = { [lang]: publicPath },
  hreflang = translations,
} = Astro.props;

const canonicalURL = new URL(canonicalPath ?? publicPath, SITE.url);
const ogImageURL = new URL(ogImage, SITE.url);
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

// hreflang solo en páginas indexables, siempre incluyendo la propia y x-default.
const hreflangLinks = noindex
  ? []
  : LANGS.flatMap((l) => (hreflang[l] ? [{ hreflang: l, href: new URL(hreflang[l], SITE.url) }] : []));
const xDefault = hreflang[DEFAULT_LANG] ?? hreflang[lang];
const otherLocales = LANGS.filter((l) => l !== lang && hreflang[l]);
---

<!doctype html>
<html lang={LOCALE_TAGS[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <GoogleTagManager />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content={BRAND_COLORS.cochinilla} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    {hreflangLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, SITE.url)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={LOCALE_TAGS[lang].og} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={LOCALE_TAGS[l].og} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <GoogleTagManagerNoscript />

    <!-- Greca zapoteca sutil como fondo global (no afecta legibilidad) -->
    <div class="bg-zapotec-pattern pointer-events-none fixed inset-0 -z-10" aria-hidden="true"></div>

    <a
      href="#content"
      class="sr-only fixed left-4 top-4 z-50 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only"
    >
      {t.a11y.skipToContent}
    </a>

    <Header transparent={transparentHeader} translations={translations} />

    <main id="content">
      <slot />
    </main>

    <Footer />

    <WhatsAppButton />
    <CookieBanner />
  </body>
</html>
